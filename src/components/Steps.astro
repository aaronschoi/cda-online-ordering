---
interface Props {
  step: string
  labels: {
    proposed: string
    reserved: string
    prepared: string
    completed: string
    canceled: string
  }
}
const { step, labels } = Astro.props
const steps = ["proposed", "reserved", "prepared", "completed"] as const
const index = steps.findIndex((id) => id === step)
---

{step === "canceled" ? (
  <p class="canceled">{labels.canceled}</p>
) : (
  <p class="steps">
    {steps.map((id, position) => (
      <span class={position === index ? "now" : undefined}>{labels[id]}</span>
    ))}
  </p>
)}
