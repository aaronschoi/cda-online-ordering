---
import DeliveryMap from "../../components/DeliveryMap.astro"
import PinForm from "../../components/PinForm.astro"
import Shell from "../../layouts/Shell.astro"
import { drawZips } from "../../domain/map-draw.ts"
import { loadPage, staffLinks } from "../../server/app.ts"

const { ordering, open, acting, error, language, copy } = await loadPage(
  Astro.locals,
  Astro.cookies,
  Astro.url,
  Astro.request,
)
if (!open) return Astro.redirect("/")
const map = await ordering.deliveryMap(acting ?? open)
const drawn = map.ok ? drawZips(map.value) : []
const byCode = new Map(drawn.map((shape) => [shape.code, shape]))
const shapes = map.ok
  ? map.value.flatMap((zip) => {
      const shape = byCode.get(zip.code)
      if (!shape?.d || shape.maxX <= shape.minX || shape.maxY <= shape.minY) return []
      return [{ ...shape, name: zip.name, open: zip.open }]
    })
  : []
const pinError = Astro.url.searchParams.get("error") === "refused" ? copy.pin.missed : error
---

<Shell title={copy.deliveryMap.title} account={acting?.name ?? copy.staff} links={staffLinks("zips", language)} signOut={false} language={language} requestUrl={Astro.url}>
  <h1>{copy.deliveryMap.title}</h1>
  <p class="lede">{copy.deliveryMap.lede}</p>
  <PinForm acting={acting} returnPath="/staff/delivery" language={language} />
  {pinError ? <p class="error">{pinError}</p> : null}
  {map.ok ? (
    <DeliveryMap
      shapes={shapes}
      acting={acting != null}
      mapLabel={copy.deliveryMap.mapLabel}
      openLabel={copy.deliveryMap.open}
      closeLabel={copy.deliveryMap.close}
      isOpen={copy.deliveryMap.isOpen}
      isClosed={copy.deliveryMap.isClosed}
    />
  ) : (
    <p class="error">{copy.deliveryMap.unread}</p>
  )}
</Shell>
