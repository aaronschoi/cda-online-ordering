---
import PinForm from "../../components/PinForm.astro"
import Shell from "../../layouts/Shell.astro"
import { drawZips } from "../../domain/map-draw.ts"
import { loadPage, staffLinks } from "../../server/app.ts"

const { ordering, open, acting, error } = await loadPage(Astro.locals, Astro.cookies, Astro.url, Astro.request)
if (!open) return Astro.redirect("/")
const map = await ordering.deliveryMap(acting ?? open)
const drawn = map.ok ? drawZips(map.value) : []
const byCode = new Map(drawn.map((shape) => [shape.code, shape]))
const pinError = Astro.url.searchParams.get("error") === "refused" ? "That PIN does not name a Staff member." : error
---

<Shell title="Delivery zips" account={acting?.name ?? "Staff"} links={staffLinks("zips")} signOut={false}>
  <h1>Delivery zips</h1>
  <p class="lede">A zip is shown when it has a name and a shape. Open it to allow Delivery. Closing it leaves Orders already placed for that zip on Delivery.</p>
  <PinForm acting={acting} returnPath="/staff/delivery" />
  {pinError ? <p class="error">{pinError}</p> : null}
  {map.ok ? (
    <>
      <svg class="map" viewBox="0 0 640 420" role="img" aria-label="Delivery zips">
        {map.value.map((zip) => {
          const shape = byCode.get(zip.code)
          if (!shape) return null
          return (
            <g>
              <path class={zip.open ? "open" : "closed"} d={shape.d} />
              <text x={shape.x} y={shape.y} text-anchor="middle">{zip.name}</text>
            </g>
          )
        })}
      </svg>
      <div class="zips">
        {map.value.map((zip) => (
          acting ? (
            <form method="post" action="/api/act">
              <input type="hidden" name="intent" value="zip" />
              <input type="hidden" name="code" value={zip.code} />
              <input type="hidden" name="open" value={zip.open ? "0" : "1"} />
              <button class={zip.open ? "primary" : "quiet"} type="submit">{zip.open ? "Close" : "Open"} {zip.name}</button>
            </form>
          ) : (
            <p>{zip.name} is {zip.open ? "open" : "closed"}.</p>
          )
        ))}
      </div>
    </>
  ) : (
    <p class="error">Delivery zips could not be read.</p>
  )}
</Shell>
