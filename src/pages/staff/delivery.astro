---
import { fill } from "../../domain/language.ts"
import Shell from "../../layouts/Shell.astro"
import { drawZips } from "../../domain/map-draw.ts"
import { loadPage } from "../../server/app.ts"

const { ordering, session, error, language, copy } = await loadPage(
  Astro.locals,
  Astro.cookies,
  Astro.url,
  Astro.request.headers.get("accept-language"),
)
if (!session) return Astro.redirect("/")
if (session.role !== "staff") return Astro.redirect("/orders")
const map = await ordering.deliveryMap(session)
const drawn = map.ok ? drawZips(map.value) : []
const byCode = new Map(drawn.map((shape) => [shape.code, shape]))
const links = [
  { href: "/staff", label: copy.nav.orders },
  { href: "/staff/delivery", label: copy.nav.deliveryZips, current: true },
  { href: "/keystatic", label: copy.nav.orderingCopy },
]
---

<Shell title={copy.deliveryMap.title} account={copy.staff} links={links} language={language} requestUrl={Astro.url}>
  <h1>{copy.deliveryMap.title}</h1>
  <p class="lede">{copy.deliveryMap.lede}</p>
  {error ? <p class="error">{error}</p> : null}
  {map.ok ? (
    <>
      <svg class="map" viewBox="0 0 640 420" role="img" aria-label={copy.deliveryMap.mapLabel}>
        {map.value.map((zip) => {
          const shape = byCode.get(zip.code)
          if (!shape) return null
          return (
            <g>
              <path class={zip.open ? "open" : "closed"} d={shape.d} />
              <text x={shape.x} y={shape.y} text-anchor="middle">{zip.name}</text>
            </g>
          )
        })}
      </svg>
      <div class="zips">
        {map.value.map((zip) => (
          <form method="post" action="/api/act">
            <input type="hidden" name="intent" value="zip" />
            <input type="hidden" name="code" value={zip.code} />
            <input type="hidden" name="open" value={zip.open ? "0" : "1"} />
            <button class={zip.open ? "primary" : "quiet"} type="submit">{fill(zip.open ? copy.deliveryMap.close : copy.deliveryMap.open, { name: zip.name })}</button>
          </form>
        ))}
      </div>
    </>
  ) : (
    <p class="error">{copy.deliveryMap.unread}</p>
  )}
</Shell>
