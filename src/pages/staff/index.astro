---
import Shell from "../../layouts/Shell.astro"
import { initial, loadPage, money, stepName, tint, when } from "../../server/app.ts"

const { ordering, session, language, copy } = await loadPage(
  Astro.locals,
  Astro.cookies,
  Astro.url,
  Astro.request.headers.get("accept-language"),
)
if (!session) return Astro.redirect("/")
if (session.role !== "staff") return Astro.redirect("/orders")
const orders = await ordering.ordersFor(session)
const links = [
  { href: "/staff", label: copy.nav.orders, current: true },
  { href: "/staff/delivery", label: copy.nav.deliveryZips },
  { href: "/keystatic", label: copy.nav.orderingCopy },
]
---

<Shell title={copy.orders.title} account={copy.staff} links={links} language={language} requestUrl={Astro.url}>
  <h1>{copy.orders.title}</h1>
  {orders.ok && orders.value.length === 0 ? <p class="empty">{copy.orders.empty}</p> : null}
  {orders.ok && orders.value.length > 0 ? (
    <table>
      <thead>
        <tr>
          <th>{copy.orders.buyer}</th>
          <th>{copy.orders.when}</th>
          <th>{copy.orders.way}</th>
          <th>{copy.orders.confirmation}</th>
          <th>{copy.orders.step}</th>
          <th class="num">{copy.goods}</th>
        </tr>
      </thead>
      <tbody>
        {orders.value.map((order) => (
          <tr>
            <td>
              <a class="who" href={`/staff/orders/${order.id}`}>
                <i style={`background:${tint(order.buyerName)}`}>{initial(order.buyerName)}</i>
                {order.buyerName}
              </a>
            </td>
            <td>{when(order.scheduledLocal, language)}</td>
            <td>{order.fulfillment === "pickup" ? copy.pickup : copy.delivery}</td>
            <td class={order.confirmation}>{order.confirmation === "confirmed" ? copy.confirmed : copy.unconfirmed}</td>
            <td>{stepName(order.step, language)}</td>
            <td class="num">{money(order.goodsCents + (order.deliveryChargeCents ?? 0), language)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : null}
  {orders.ok ? null : <p class="error">{copy.orders.unread}</p>}
</Shell>
