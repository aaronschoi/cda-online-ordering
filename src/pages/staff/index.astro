---
import PinForm from "../../components/PinForm.astro"
import Shell from "../../layouts/Shell.astro"
import { initial, loadPage, money, staffLinks, stepName, tint, when } from "../../server/app.ts"

const { ordering, open, acting, error } = await loadPage(Astro.locals, Astro.cookies, Astro.url, Astro.request)
if (!open) return Astro.redirect("/")
const orders = await ordering.ordersFor(acting ?? open)
const pinError = Astro.url.searchParams.get("error") === "refused" ? "That PIN does not name a Staff member." : error
---

<Shell title="Orders" account={acting?.name ?? "Staff"} links={staffLinks("orders")} signOut={false}>
  <h1>Orders</h1>
  <p class="lede">Every Order is listed here before anyone enters a PIN. A PIN is required to confirm, advance, cancel, approve, or deny.</p>
  <PinForm acting={acting} returnPath="/staff" />
  {pinError ? <p class="error">{pinError}</p> : null}
  {orders.ok && orders.value.length === 0 ? <p class="empty">No Orders yet.</p> : null}
  {orders.ok && orders.value.length > 0 ? (
    <table>
      <thead>
        <tr>
          <th>Buyer</th>
          <th>When</th>
          <th>Way</th>
          <th>Confirmation</th>
          <th>Step</th>
          <th class="num">Goods</th>
        </tr>
      </thead>
      <tbody>
        {orders.value.map((order) => (
          <tr>
            <td>
              <a class="who" href={`/staff/orders/${order.id}`}>
                <i style={`background:${tint(order.buyerName)}`}>{initial(order.buyerName)}</i>
                {order.buyerName}
              </a>
            </td>
            <td>{when(order.scheduledLocal)}</td>
            <td>{order.fulfillment === "pickup" ? "Pickup" : "Delivery"}</td>
            <td class={order.confirmation}>{order.confirmation === "confirmed" ? "Confirmed" : "Unconfirmed"}</td>
            <td>{stepName(order.step)}</td>
            <td class="num">{money(order.goodsCents + (order.deliveryChargeCents ?? 0))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : null}
  {orders.ok ? null : <p class="error">Orders could not be read.</p>}
</Shell>
