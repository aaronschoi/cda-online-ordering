---
import { fill } from "../../../domain/language.ts"
import PinForm from "../../../components/PinForm.astro"
import Steps from "../../../components/Steps.astro"
import Shell from "../../../layouts/Shell.astro"
import { loadPage, money, staffLinks, when } from "../../../server/app.ts"

const { ordering, open, acting, error, language, copy } = await loadPage(
  Astro.locals,
  Astro.cookies,
  Astro.url,
  Astro.request,
)
if (!open) return Astro.redirect("/")
const orderId = Astro.params.id ?? ""
const result = await ordering.orderFor(acting ?? open, orderId)
if (!result.ok) return Astro.redirect("/staff")
const order = result.value
const advance = order.actions?.advance
const nextLabel =
  advance === "reserved"
    ? copy.staffOrder.markReserved
    : advance === "prepared"
      ? copy.staffOrder.markPrepared
      : advance === "completed"
        ? copy.staffOrder.markCompleted
        : ""
const pinError = Astro.url.searchParams.get("error") === "refused" ? copy.pin.missed : error
---

<Shell title={order.buyerName} account={acting?.name ?? copy.staff} links={staffLinks("orders", language)} signOut={false} language={language} requestUrl={Astro.url}>
  <div class="order-head">
    <h1>{order.buyerName}</h1>
    <p class={order.confirmation}>{order.confirmation === "confirmed" ? copy.confirmed : copy.unconfirmed}</p>
  </div>
  <PinForm acting={acting} returnPath={`/staff/orders/${order.id}`} language={language} />
  <Steps step={order.step} labels={copy.steps} />
  {pinError ? <p class="error">{pinError}</p> : null}
  <p>{order.seasonName} · {order.fulfillment === "pickup" ? copy.pickup : copy.delivery} · {when(order.scheduledLocal, language)}</p>
  {order.address ? <p>{order.address.street}, {order.address.city}, {order.address.state} {order.address.zip} · {order.address.phone}</p> : null}
  {order.deliveryNote ? <p>{order.deliveryNote}</p> : null}
  {order.unitsOnHandUnreadable ? <p class="error">{copy.staffOrder.unitsUnread}</p> : null}
  <table>
    <thead>
      <tr>
        <th>{copy.staffOrder.sku}</th>
        <th class="num">{copy.staffOrder.quantity}</th>
        <th class="num">{copy.staffOrder.price}</th>
        <th class="num">{copy.staffOrder.units}</th>
      </tr>
    </thead>
    <tbody>
      {order.lines.map((line) => (
        <tr>
          <td>{fill(copy.namedSku, { name: line.styleName, color: line.color, size: line.size })}<div class="meta">{line.styleDescription}</div></td>
          <td class="num">{line.quantity}</td>
          <td class="num">{money(line.priceCents, language)}</td>
          <td class="num">{line.unitsOnHand == null ? "—" : line.unitsOnHand}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="totals">
    <div><span>{copy.goods}</span><span>{money(order.goodsCents, language)}</span></div>
    {order.deliveryChargeCents != null ? <div><span>{copy.order.deliveryCharge}</span><span>{money(order.deliveryChargeCents, language)}</span></div> : null}
  </div>
  <p class="lede">{copy.staffOrder.fulfill}</p>
  <div class="choice">
    {order.actions?.confirm ? (
      <form method="post" action="/api/act">
        <input type="hidden" name="intent" value="confirm" />
        <input type="hidden" name="orderId" value={order.id} />
        <button class="primary" type="submit">{copy.staffOrder.confirm}</button>
      </form>
    ) : null}
    {nextLabel ? (
      <form method="post" action="/api/act">
        <input type="hidden" name="intent" value="advance" />
        <input type="hidden" name="orderId" value={order.id} />
        <button class="primary" type="submit">{nextLabel}</button>
      </form>
    ) : null}
    {order.actions?.cancel ? (
      <form method="post" action="/api/act">
        <input type="hidden" name="intent" value="cancel" />
        <input type="hidden" name="orderId" value={order.id} />
        <button class="quiet" type="submit">{copy.staffOrder.cancel}</button>
      </form>
    ) : null}
  </div>
  {order.waitingChange ? (
    <section>
      <h2>{copy.order.changeTitle}</h2>
      {order.waitingChange.lines.map((line) => (
        <p>{fill(copy.namedSku, { name: line.styleName, color: line.color, size: line.size })} × {line.quantity}{line.priceCents == null ? copy.order.priceAtApproval : ` · ${money(line.priceCents, language)}`}</p>
      ))}
      <p>{when(order.waitingChange.scheduledLocal, language)}</p>
      {order.waitingChange.address ? <p>{order.waitingChange.address.street}, {order.waitingChange.address.zip} · {order.waitingChange.address.phone}</p> : null}
      {order.actions?.approve || order.actions?.deny ? (
        <div class="choice">
          {order.actions?.approve ? (
            <form method="post" action="/api/act">
              <input type="hidden" name="intent" value="approve" />
              <input type="hidden" name="orderId" value={order.id} />
              <button class="primary" type="submit">{copy.staffOrder.approve}</button>
            </form>
          ) : null}
          {order.actions?.deny ? (
            <form method="post" action="/api/act">
              <input type="hidden" name="intent" value="deny" />
              <input type="hidden" name="orderId" value={order.id} />
              <button class="quiet" type="submit">{copy.staffOrder.deny}</button>
            </form>
          ) : null}
        </div>
      ) : null}
    </section>
  ) : null}
</Shell>
