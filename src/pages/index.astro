---
import { fill } from "../domain/language.ts"
import Shell from "../layouts/Shell.astro"
import { loadPage } from "../server/app.ts"

const { session, open, accessHeader, error, language, copy } = await loadPage(
  Astro.locals,
  Astro.cookies,
  Astro.url,
  Astro.request,
)
if (session?.role === "buyer") return Astro.redirect("/line")
if (open && accessHeader) return Astro.redirect("/staff")

const sent = Astro.url.searchParams.get("sent") === "1"
const email = Astro.url.searchParams.get("email") ?? ""
const devCode = import.meta.env.DEV ? Astro.cookies.get("cda_dev_code")?.value : undefined
---

<Shell title={copy.signIn.title} language={language} requestUrl={Astro.url}>
  <h1>{copy.signIn.title}</h1>
  <p class="lede">{copy.signIn.lede}</p>
  {error ? <p class="error">{error}</p> : null}
  <form class="place" method="post" action="/api/act">
    <input type="hidden" name="intent" value={sent ? "buyer-sign-in" : "request-code"} />
    <label>
      {copy.signIn.buyerEmail}
      <input name="email" type="email" autocomplete="username" required value={email} />
    </label>
    {sent ? (
      <label>
        {copy.signIn.code}
        <input name="code" inputmode="numeric" autocomplete="one-time-code" required />
      </label>
    ) : null}
    <button class="primary" type="submit">{sent ? copy.signIn.title : copy.signIn.emailCode}</button>
  </form>
  <p class="local"><a href="/staff">{copy.staff}</a></p>
  {import.meta.env.DEV ? (
    <p class="local">
      {devCode ? `${fill(copy.signIn.localCode, { code: devCode })} ` : ""}
      {copy.signIn.localHint}
    </p>
  ) : null}
</Shell>
