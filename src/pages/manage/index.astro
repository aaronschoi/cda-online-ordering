---
import PinForm from "../../components/PinForm.astro"
import Shell from "../../layouts/Shell.astro"
import { loadPage, staffLinks, when } from "../../server/app.ts"

const { ordering, open, acting, error, managerEmail } = await loadPage(Astro.locals, Astro.cookies, Astro.url, Astro.request)
if (!open || !managerEmail) return Astro.redirect("/")
const [directory, record] = await Promise.all([
  ordering.staffDirectory(managerEmail),
  ordering.staffRecord(managerEmail),
])
const staff = directory.ok ? directory.value : []
const managers = staff.filter((member) => member.email).length
---

<Shell title="Staff" account={acting?.name ?? "Staff"} links={staffLinks("staff")} signOut={false}>
  <h1>Staff</h1>
  <p class="lede">A Manager keeps this list and reads the Staff log. Season, Line, Change cutoff, Delivery charge, Buyer copy, and Delivery zip names are edited in Ordering copy. A PIN is not required for that work.</p>
  <PinForm acting={acting} returnPath="/manage" ask={false} />
  {error ? <p class="error">{error}</p> : null}
  {directory.ok ? (
    staff.map((member) => (
      <div class="person">
        <p class="role">{member.email ? `Manager · ${member.email}` : "Staff"}</p>
        <form class="person-edit" method="post" action="/api/act">
          <input type="hidden" name="intent" value="save-staff" />
          <input type="hidden" name="id" value={member.id} />
          <label>
            Name
            <input name="name" required value={member.name} />
          </label>
          <label>
            PIN
            <input name="pin" inputmode="numeric" autocomplete="off" minlength="4" maxlength="4" pattern="[0-9]{4}" required value={member.pin ?? ""} />
          </label>
          <button class="primary" type="submit">Save</button>
        </form>
        {member.email && managers <= 1 ? null : (
          <div class="choice">
            {member.email ? (
              <form method="post" action="/api/act">
                <input type="hidden" name="intent" value="clear-email" />
                <input type="hidden" name="id" value={member.id} />
                <button class="quiet" type="submit">Clear email</button>
              </form>
            ) : null}
            <form method="post" action="/api/act">
              <input type="hidden" name="intent" value="remove-staff" />
              <input type="hidden" name="id" value={member.id} />
              <button class="quiet" type="submit">Remove</button>
            </form>
          </div>
        )}
      </div>
    ))
  ) : (
    <p class="error">The Staff list could not be read.</p>
  )}
  <form class="place manage-add" method="post" action="/api/act">
    <h2>Add Staff</h2>
    <input type="hidden" name="intent" value="save-staff" />
    <label>
      Name
      <input name="name" required />
    </label>
    <label>
      PIN
      <input name="pin" inputmode="numeric" autocomplete="off" minlength="4" maxlength="4" pattern="[0-9]{4}" required />
    </label>
    <button class="primary" type="submit">Add Staff</button>
  </form>
  <form class="place" method="post" action="/api/act">
    <h2>Add a Manager</h2>
    <input type="hidden" name="intent" value="add-manager" />
    <label>
      Name
      <input name="name" required />
    </label>
    <label>
      Email
      <input name="email" type="email" autocomplete="off" required />
    </label>
    <label>
      PIN
      <input name="pin" inputmode="numeric" autocomplete="off" minlength="4" maxlength="4" pattern="[0-9]{4}" required />
    </label>
    <button class="primary" type="submit">Add a Manager</button>
  </form>
  <h2>Staff log</h2>
  {record.ok && record.value.length === 0 ? <p class="empty">No PIN actions yet.</p> : null}
  {record.ok && record.value.length > 0 ? (
    <table>
      <thead>
        <tr>
          <th>Staff</th>
          <th>Action</th>
          <th>When</th>
          <th>Order or Delivery zip</th>
        </tr>
      </thead>
      <tbody>
        {record.value.map((entry) => (
          <tr>
            <td>{entry.staffName}</td>
            <td>{entry.action}</td>
            <td>{when(entry.actedLocal)}</td>
            <td>
              {entry.orderId ? <a href={`/staff/orders/${entry.orderId}`}>Order</a> : null}
              {entry.zip ? entry.zip : null}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : null}
  {record.ok ? null : <p class="error">The Staff log could not be read.</p>}
</Shell>
