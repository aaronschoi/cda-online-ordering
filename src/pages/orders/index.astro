---
import Shell from "../../layouts/Shell.astro"
import { loadPage, money, stepName, when } from "../../server/app.ts"

const { ordering, session, language, copy } = await loadPage(
  Astro.locals,
  Astro.cookies,
  Astro.url,
  Astro.request,
)
if (!session) return Astro.redirect("/")
if (session.role !== "buyer") return Astro.redirect("/staff")
const orders = await ordering.ordersFor(session)
const links = [
  { href: "/line", label: copy.nav.line },
  { href: "/orders", label: copy.nav.orders, current: true },
]
---

<Shell title={copy.orders.title} account={session.buyerName ?? session.email} links={links} language={language} requestUrl={Astro.url}>
  <h1>{copy.orders.title}</h1>
  {orders.ok && orders.value.length === 0 ? <p class="empty">{copy.orders.empty} <a href="/line">{copy.orders.choose}</a></p> : null}
  {orders.ok && orders.value.length > 0 ? (
    <table>
      <thead>
        <tr>
          <th>{copy.orders.season}</th>
          <th>{copy.orders.when}</th>
          <th>{copy.orders.way}</th>
          <th>{copy.orders.confirmation}</th>
          <th>{copy.orders.step}</th>
          <th class="num">{copy.goods}</th>
        </tr>
      </thead>
      <tbody>
        {orders.value.map((order) => (
          <tr>
            <td><a href={`/orders/${order.id}`}>{order.seasonName}</a></td>
            <td>{when(order.scheduledLocal, language)}</td>
            <td>{order.fulfillment === "pickup" ? copy.pickup : copy.delivery}</td>
            <td class={order.confirmation}>{order.confirmation === "confirmed" ? copy.confirmed : copy.unconfirmed}</td>
            <td>{stepName(order.step, language)}</td>
            <td class="num">{money(order.goodsCents, language)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : null}
</Shell>
