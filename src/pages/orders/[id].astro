---
import Steps from "../../components/Steps.astro"
import Shell from "../../layouts/Shell.astro"
import { loadPage, money, when } from "../../server/app.ts"

const { ordering, session, error } = await loadPage(Astro.locals, Astro.cookies, Astro.url)
if (!session) return Astro.redirect("/")
if (session.role !== "buyer") return Astro.redirect(`/staff/orders/${Astro.params.id}`)
const orderId = Astro.params.id ?? ""
const result = await ordering.orderFor(session, orderId)
if (!result.ok) return Astro.redirect("/orders?error=not-found")
const order = result.value
const choices = await ordering.changeChoices(session, orderId)
const open = order.step === "proposed" || order.step === "reserved" || order.step === "prepared"
const links = [
  { href: "/line", label: "Line" },
  { href: "/orders", label: "Orders", current: true },
]
---

<Shell title="Order" account={session.buyerName ?? session.email} links={links}>
  <div class="order-head">
    <h1>{order.seasonName}</h1>
    <p class={order.confirmation}>{order.confirmation === "confirmed" ? "Confirmed" : "Unconfirmed"}</p>
  </div>
  <Steps step={order.step} />
  {error ? <p class="error">{error}</p> : null}
  <p>{order.fulfillment === "pickup" ? "Pickup" : "Delivery"} · {when(order.scheduledLocal)}</p>
  {order.address ? (
    <p>{order.address.street}, {order.address.city}, {order.address.state} {order.address.zip} · {order.address.phone}</p>
  ) : null}
  {order.deliveryNote ? <p>{order.deliveryNote}</p> : null}
  <div class="totals">
    {order.lines.map((line) => (
      <div>
        <span>{line.styleName}, {line.color}, size {line.size} × {line.quantity}</span>
        <span>{money(line.priceCents * line.quantity)}</span>
      </div>
    ))}
    <div><span>Goods</span><span>{money(order.goodsCents)}</span></div>
    {order.deliveryChargeCents != null ? <div><span>Delivery charge</span><span>{money(order.deliveryChargeCents)}</span></div> : null}
  </div>

  {order.waitingChange ? (
    <form method="post" action="/api/act">
      <input type="hidden" name="intent" value="withdraw" />
      <input type="hidden" name="orderId" value={order.id} />
      <p>A Change request is waiting.</p>
      <button class="quiet" type="submit">Withdraw the Change request</button>
    </form>
  ) : null}

  {open && !order.waitingChange && choices.ok ? (
    <form class="place" method="post" action="/api/act">
      <input type="hidden" name="intent" value="change" />
      <input type="hidden" name="orderId" value={order.id} />
      <h2>Change request</h2>
      {choices.value.map((sku) => (
        <label>
          {sku.styleName}, {sku.color}, size {sku.size}{sku.onLine ? "" : " (kept on this Order)"}
          <input name={`qty.${sku.skuId}`} type="number" min="0" step="1" value={order.lines.find((line) => line.skuId === sku.skuId)?.quantity ?? 0} />
        </label>
      ))}
      <label>
        Time
        <input name="scheduledLocal" type="datetime-local" value={order.scheduledLocal} required />
      </label>
      {order.fulfillment === "delivery" && order.address ? (
        <fieldset>
          <label>Street <input name="street" value={order.address.street} required /></label>
          <div class="address">
            <label>City <input name="city" value={order.address.city} required /></label>
            <label>State <input name="state" value={order.address.state} required /></label>
            <label>Zip <input name="zip" value={order.address.zip} required /></label>
            <label>Phone <input name="phone" value={order.address.phone} required /></label>
          </div>
          <label>Delivery note <textarea name="deliveryNote" rows="2">{order.deliveryNote ?? ""}</textarea></label>
        </fieldset>
      ) : null}
      <button class="primary" type="submit">Submit Change request</button>
    </form>
  ) : null}
</Shell>
